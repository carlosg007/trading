__pycache__/
*.py[cod]
.venv/
.env
.ipynb_checkpoints/
*.duckdb
*.parquet
*.csv
scratch/
courses/

# Pipeline run logs — stdout captures from bt-run and the five stages.
# Reproducible output rather than source, like the *.parquet and *.csv rules
# above: the evidence a promotion decision rests on lives in
# /mnt/backtest/artifacts/<strat>_<timestamp>/, which is timestamped and never
# overwritten. A 2.9 MB stdout capture in git history is not that.
*.log

# Live regime state. `realtime/regime_daemon.py` rewrites this every bar, so
# it is a running process's scratch space rather than source — committing it
# would make every `git status` dirty and every diff meaningless. It is also
# not evidence: the copy that matters is whatever the execution log recorded
# at the moment an order was placed.
data/live_regime_state.json

# Trained ML confirmation models. Binary artifacts rebuilt from a fit, and a
# pickle is arbitrary code at load time. Their SIDECARS (`models/*.json`) are
# deliberately NOT ignored: the feature ORDER and the probability threshold are
# the model's contract with `evaluate_ml_gate`, they change what the filter
# does, and they belong in review.
models/*.pkl
models/*.joblib
models/*.onnx
