__pycache__/
*.py[cod]
.venv/
.env
.ipynb_checkpoints/
*.duckdb
*.parquet
*.csv
# `reports/` is a SYMLINK to /mnt/backtest/reports since 2026-08-30, and a
# symlink is a FILE to git. The *.csv rule above hid the directory's contents
# while it was a real directory; it does not hide the link itself, which git
# would otherwise offer to track - committing an absolute NFS path that is
# wrong on any machine without this mount.
/reports
scratch/
courses/

# Pipeline run logs — stdout captures from bt-run and the five stages.
# Reproducible output rather than source, like the *.parquet and *.csv rules
# above: the evidence a promotion decision rests on lives in
# /mnt/backtest/artifacts/<strat>_<timestamp>/, which is timestamped and never
# overwritten. A 2.9 MB stdout capture in git history is not that.
*.log
# The units split their streams: StandardError=append: writes .err beside the
# .log, and logrotate rotates both. Same rule, same reason.
*.err

# Live regime state. `realtime/regime_daemon.py` rewrites this every bar, so
# it is a running process's scratch space rather than source — committing it
# would make every `git status` dirty and every diff meaningless. It is also
# not evidence: the copy that matters is whatever the execution log recorded
# at the moment an order was placed.
data/live_regime_state.json

# Trained ML confirmation models. Binary artifacts rebuilt from a fit, and a
# pickle is arbitrary code at load time. Their SIDECARS (`models/*.json`) are
# deliberately NOT ignored: the feature ORDER and the probability threshold are
# the model's contract with `evaluate_ml_gate`, they change what the filter
# does, and they belong in review.
models/*.pkl
models/*.joblib
models/*.onnx

# Numba on-disk cache — see NUMBA_CACHE_DIR in deploy/systemd/trading.env.
.cache/

# Rotated run logs. `*.log` and `*.err` above catch the LIVE file, but
# logrotate renames to `master_live.log.1` and `master_live.log.2.gz`, which
# match neither - which is why 54 of them were sitting in `git status`.
# `logs/.gitkeep` is tracked and stays tracked; the negation keeps the
# directory placeholder meaningful if it is ever removed and re-added.
logs/
!logs/.gitkeep

# Local backups. Written by hand before a destructive edit -
# `config/portfolios.json.bak` is the pre-cleanup routing table - and useful
# exactly where they sit. The copy that matters for review is the git history
# the edit was made against.
*.bak

# Lifecycle run write-ups. Operator scratchpads recording one run on one day;
# the artifacts they describe live under /mnt/backtest/artifacts/.
full_lifecycle_run_results.md

# Watchdog alert state. Rewritten by the watchdog every cycle, exactly like
# `data/live_regime_state.json` above and ignored for the same reason: a
# running process's scratch space makes every `git status` dirty and every
# diff meaningless.
data/watchdog_alert_state.json

# Operator run-books generated by Claude Code for a specific pipeline pass
# (Stage 4.5 command sets, re-promotion batches). They are snapshots of one
# day of the incubator, not tooling - scripts/register_incubator_batch.py is
# the reproducible form. Regenerate rather than resurrect a stale one.
scripts/scratchpad/
