    "indicators": "adx_14 and atr_14, both period 14"
  },
  "quadrants": {
    "Q1": {
      "id": 1,
      "label": "High Volatility / Trending",
      "rule": {
        "adx_14": "> 25.0",
        "atr_14": "> theta_vol"
      }
    },
    "Q2": {
      "id": 2,
      "label": "High Volatility / Ranging",
      "rule": {
        "adx_14": "<= 25.0",
        "atr_14": "> theta_vol"
      }
    },
    "Q3": {
      "id": 3,
      "label": "Low Volatility / Trending",
      "rule": {
        "adx_14": "> 25.0",
        "atr_14": "<= theta_vol"
      }
    },
    "Q4": {
      "id": 4,
      "label": "Low Volatility / Ranging",
      "rule": {
        "adx_14": "<= 25.0",
        "atr_14": "<= theta_vol"
      }
    }
  },
  "theta_vol": {
    "definition": "median(ATR_14) over the pinned in-sample anchor",
    "anchor_start": "2013-01-01",
    "anchor_end": "2022-12-31",
    "scope": "PER (symbol, timeframe)",
    "note": "theta_vol is LOADED from the pinned anchor, never computed over a caller's window. A median taken over the request's own window is a property of the REQUEST, not the contract: on a quiet morning every bar reads high-volatility and a Q1-certified strategy is handed permission for a market it is not in. It is per (symbol, TIMEFRAME) - NQ is 7.90 at 15m and 11.33 at 30m, a 43% different boundary on the same tape - so this file stores no theta_vol value at all; read it through mdlib.regimes.provenance()."
  },
