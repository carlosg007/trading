# USER-SCOPE variant of ../trading-nt8-listener.service. Generated, not hand-edited: the
# body below is that file with three kinds of line changed and nothing else,
# so the two scopes cannot drift into running the service differently.
#
# WHAT DIFFERS, AND WHY - the same two layered failures the regime daemon hit
# (449fce0), each with its own exit code and neither pointing at itself:
#
#   ProtectKernelModules=yes   REMOVED
#       218/CAPABILITIES, "Failed to drop capabilities: Operation not
#       permitted". There is no CapabilityBoundingSet line to grep for: the
#       directive IMPLIES CapabilityBoundingSet=~CAP_SYS_MODULE, and a user
#       manager cannot narrow a bounding set. Reproduced alone with
#       `systemd-run --user --property=ProtectKernelModules=yes /bin/true`.
#
#   User= / Group=             REMOVED
#       217/USER, "Failed to keep CAP_SYS_ADMIN: Operation not permitted".
#       The fatal pair is `User=` WITH `RestrictNamespaces=yes`: systemd must
#       keep CAP_SYS_ADMIN across the credential change to build the
#       namespace, and an unprivileged manager cannot. Tested pairwise -
#       User= alone passes, and so does User= with ProtectSystem=strict,
#       ProtectHome=read-only or PrivateTmp. Only RestrictNamespaces breaks
#       it.
#
#   WantedBy=default.target    REPLACES multi-user.target, which is a system
#       target and means nothing to a user manager.
#
# EVERY OTHER HARDENING DIRECTIVE IS KEPT, each verified under --user in
# combination with ProtectSystem=strict rather than bare (a bare probe builds
# no mount namespace and passes things that fail in situ - that false pass
# cost a wrong fix on the regime daemon): ProtectKernelTunables,
# ProtectControlGroups, RestrictNamespaces, RestrictRealtime, RestrictSUIDSGID,
# LockPersonality, NoNewPrivileges, ProtectSystem=strict, ProtectHome=read-only,
# PrivateTmp, MemoryDenyWriteExecute.
#
# Nothing is really given up: an unprivileged process has no CAP_SYS_MODULE to
# begin with, which is exactly why the bounding set cannot be narrowed.
#
# THE SYSTEM UNIT KEEPS ALL THREE and must. Under `systemd --system` the
# manager is privileged, so the bounding set is real protection there, and
# dropping User= would run the service as ROOT - leaving root-owned files in
# logs/, data/ and /mnt/backtest/artifacts that the next non-root run cannot
# reopen.

# The push receiver. NT8 POSTs one closed bar; this appends it to the spool.
#
# INSTALL
#   sudo cp deploy/systemd/trading-nt8-listener.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trading-nt8-listener
#
# THIS UNIT SENDS NOTHING. It receives, validates and appends. `live/
# dispatcher.py` remains the only module in this repository that puts an order
# on the wire.

[Unit]
Description=NT8 Live Bar HTTP Listener & Spooler
Documentation=file:///home/cgrullon/src/trading/deploy/RUNBOOK.md
After=network.target
# The spool is on the NFS mount. Without this the listener can start BEFORE
# /mnt/backtest is mounted, create the spool directory on the local root
# filesystem underneath the mountpoint, and write every bar there — where the
# mount then HIDES them. The feed reads an empty directory, the listener
# reports bars accepted, and both are telling the truth.
RequiresMountsFor=/mnt/backtest

[Service]
Type=simple
WorkingDirectory=/home/cgrullon/src/trading

# BT_NT8_SPOOL lives here, and is what points this at the same directory
# realtime/nt8_feed.py reads. PYTHONUNBUFFERED is set here too; it is repeated
# below because a receiver whose output is a buffered pipe shows an operator
# nothing for 4KB, and the journal is the only view this unit has.
EnvironmentFile=-/home/cgrullon/src/trading/deploy/systemd/trading.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/cgrullon/src/trading/.venv/bin/python3 \
    /home/cgrullon/src/trading/realtime/nt8_bar_listener.py \
    --port 8000

# Always. A receiver that stays down is a feed that goes quiet, and a quiet
# feed reads exactly like a quiet market — see the watchdog. RestartSec=5 is
# under systemd's DefaultStartLimitIntervalSec=10s/Burst=5 only in the sense
# that five restarts take 25s, so a genuine crash loop does NOT latch the unit
# off. That is deliberate: for this unit, retrying forever beats staying down.
Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

# --- sandboxing -----------------------------------------------------------
# It reads the repo and writes exactly one directory: the spool.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/backtest/artifacts
# See NUMBA_CACHE_DIR in trading.env — the read-only home makes pandas_ta's
# @njit(cache=True) RAISE on import for anything that pulls the numeric stack.
ReadWritePaths=/home/cgrullon/src/trading/.cache
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# The JOURNAL, not append: files like the sibling units. uvicorn logs a line
# per request and the journal already rotates and rate-limits; `journalctl -u
# trading-nt8-listener` is also the only place a bind failure shows up, since
# a process that dies before opening its log file writes nothing to it.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
