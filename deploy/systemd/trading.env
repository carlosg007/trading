# NON-SECRET paths and tuning for the systemd units.
#
# THE BROKER CREDENTIALS ARE NOT HERE AND MUST NOT BE. `.env` is read directly
# by `resolve_credentials`, deliberately NOT exported into the environment:
# everything in the environment is inherited by every subprocess, which is how
# a webhook URL - which IS the credential for a live account - ends up in an
# unrelated tool's debug output. Put CROSSTRADE_WEBHOOK_URL and
# CROSSTRADE_API_KEY in /home/cgrullon/src/trading/.env, chmod 600.

BT_ENV_FILE=/home/cgrullon/src/trading/.env
BT_ENGINE_STATE=/home/cgrullon/src/trading/data/engine_state.json
BT_KILL_SWITCH=/home/cgrullon/src/trading/data/KILL_SWITCH
BT_NT8_SPOOL=/mnt/backtest/artifacts/nt8_bars

# Numba writes its on-disk cache next to the SOURCE by default, and the source
# is in .venv under a home directory these units mount READ-ONLY. pandas_ta
# decorates with @njit(cache=True), so the import did not degrade to
# recompiling — it raised, `backtest.profiler` became unimportable, and
# `PortfolioConfigError` was swallowed by strict_config=False. The daemon then
# published with an EMPTY registry: every strategy stood down, nothing in the
# state file, and a log that reads like a market with nothing registered in it.
# Point the cache somewhere writable and list it in ReadWritePaths.
NUMBA_CACHE_DIR=/home/cgrullon/src/trading/.cache/numba

# One thread per process. These loops are IO-bound and several run at once;
# numpy grabbing every core in each is contention, not speed.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
PYTHONUNBUFFERED=1
